rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Settings: authenticated users can read; only the owner can modify their own settings
    match /user_settings/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['displayName', 'favoriteTeamId']) &&
        (!('displayName' in request.resource.data) || request.resource.data.displayName is string) &&
        (!('favoriteTeamId' in request.resource.data) || request.resource.data.favoriteTeamId is string);
    }

    // Groups: authenticated users can read and create groups
    // Users can join by adding strictly their own UID to the members array
    // Group owners can update group privacy settings and set ownerId
    match /groups/{groupId} {
      function isGroupOwner() {
        return isAuthenticated() && (
          ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
          (!('ownerId' in resource.data) && resource.data.members is list && resource.data.members.size() > 0 && resource.data.members[0] == request.auth.uid)
        );
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['name', 'teamId', 'league', 'members', 'isPrivate']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.members[0] == request.auth.uid &&
        (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
        (!('password' in request.resource.data));
      allow update: if isAuthenticated() && (
        // Case 1: Member joining group
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members is list &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
        ) ||
        // Case 2: Group owner updating privacy settings or setting ownerId
        (
          isGroupOwner() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPrivate', 'passwordHash', 'salt', 'ownerId']) &&
          (!('isPrivate' in request.resource.data) || request.resource.data.isPrivate is bool) &&
          (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
          (!('password' in request.resource.data))
        )
      );
      allow delete: if isGroupOwner();
    }

    // Team Game Picks (strictly formatted as teamId + league suffix, e.g. 152m, 152w)
    // Constrained regex matching ensures this rule never collides with or overrides root collections
    match /{collectionName}/{gameId} {
      function isPickCollection() {
        return collectionName.matches('^[0-9]+[mw]$');
      }

      allow read: if isAuthenticated() && isPickCollection();
      allow create: if isAuthenticated() && 
        isPickCollection() &&
        request.resource.data.keys().hasOnly([request.auth.uid, request.auth.uid + '_time']) &&
        request.resource.data[request.auth.uid] is string &&
        request.resource.data[request.auth.uid + '_time'] is number;
      allow update: if isAuthenticated() && 
        isPickCollection() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid, request.auth.uid + '_time']) &&
        request.resource.data[request.auth.uid] is string &&
        request.resource.data[request.auth.uid + '_time'] is number;
      allow delete: if false;
    }
  }
}
